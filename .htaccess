# Winsum Home — bảo vệ khi upload thẳng mã nguồn vào public_html (Apache / LiteSpeed).

Options -Indexes
DirectoryIndex index.php

# Không cho tải file cấu hình, SQL, script, test, log mail và metadata git.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|sql|scripts|tests|storage|bootstrap|\.git)(/|$) - [F,L]
</IfModule>

<FilesMatch "(?i)\.(sql|md|lock|log|ini|env|gitignore|gitkeep)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.ht">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Ép HTTPS: bật trong hPanel (Security → SSL → Force HTTPS) hoặc bỏ comment 3 dòng dưới sau khi SSL đã cấp.
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !=https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
